 MergeExpression {
  inputs 2
  temp_name0 c0
  temp_expr0 hypot(r-b,g-(r+b)/2)/4
  temp_name1 c
  temp_expr1 (1+0.1)*(c0*c0/(c0+0.1))
  temp_name2 _m
  temp_expr2 m+m0*Ar+m1*Ag+m2*Ab
  temp_name3 ex
