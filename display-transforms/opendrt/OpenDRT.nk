set N206c8c10 [stack 0]
  Expression {
   temp_name0 Yd
   temp_expr0 0.2627*r+0.6780*g+0.0593*b
   temp_name1 p
   temp_expr1 1.2
   expr0 r*pow(Yd,(1-p)/p)
   expr1 g*pow(Yd,(1-p)/p)
   expr2 b*pow(Yd,(1-p)/p)
