set cut_paste_input [stack 0]
push $cut_paste_input
Group {
 name CLFShaper
 knobChanged "n = nuke.thisNode()\nif nuke.thisKnob().name() in ('preset', 'showPanel'):\n    x = n\['preset'].getValue() == 8\n    for k in ('w0', 'o', 'x0', 'y0', 'k'):\n        n\[k].setVisible(x)\n"
 tile_color 0x4a3a7aff
 label "\[value preset]"
 xpos 0
 addUserKnob {20 CLFShaper}
 addUserKnob {26 about l " " T "<font color=#ccc><b>CLFShaper</b> | part of <a href=https://github.com/jedypod/open-display-transform>open-display-transform</a><br>Place at the head of the chain to bake. CLFGenerate goes at the tail."}
 addUserKnob {4 preset l shaper t "Log encoding used to shape the 3D LUT domain. The exact same curve is written into the CLF as a parametric Log node, so the LUT takes linear input. T-LogE is what the released OpenDRT OCIO config uses." M {"Filmlight T-LogE" "Filmlight T-Log" ACEScct "Arri LogC3" "Arri LogC4" "Sony S-Log3" "Red Log3G10" "DaVinci Intermediate" XLog}}
 addUserKnob {7 w0 t "XLog: linear value that maps to 1.0" +HIDDEN R 10 256}
 w0 128
 addUserKnob {7 o t "XLog: log asymptote offset, as 2^-o" +HIDDEN R 0 12}
 o 7.5
 addUserKnob {7 x0 t "XLog: lower intersection constraint x" +HIDDEN R 0 0.5}
 addUserKnob {7 y0 t "XLog: lower intersection constraint y" +HIDDEN R 0 0.5}
 y0 0.075
 addUserKnob {7 k t "XLog: slope of the linear extension" +HIDDEN R 0 0.2}
 k 0.06
 addUserKnob {3 cube_size l "cube size" t "3D LUT lattice size. 48 matches the released OpenDRT OCIO config. CLF allows up to 128."}
 cube_size 48
 addUserKnob {6 pattern l "show pattern" t "Output the shaped CMSTestPattern instead of the input. CLFGenerate toggles this while baking." +STARTLINE}
 addUserKnob {20 Params}
 addUserKnob {7 o0 t "x offset: the y asymptote of the log curve" +DISABLED}
 o0 {{-(2**-o)}}
 addUserKnob {7 s0 t "s0 = scale factor to satisfy intersection constraint at (x0, y0)" +DISABLED}
 s0 {{(1-y0)/log((w0-o0)/(x0-o0))}}
 addUserKnob {7 o1 t "y offset to satisfy intersection constraint at (w0, 1)" +DISABLED}
 o1 {{1-s0*log(w0-o0)}}
 addUserKnob {7 x1 t "x1 is x coordinate of linear extension intercept" +DISABLED}
 x1 {{s0*log(k*s0*exp(o1/s0))}}
 addUserKnob {7 y1 t "y1 is y coordinate of linear extension intercept" +DISABLED}
 y1 {{exp((x1-o1)/s0)+o0}}
 addUserKnob {26 div1 l "" +STARTLINE}
 addUserKnob {7 gs l logSideSlope t "OCIO LogCameraTransform logSideSlope (base 2)" +DISABLED}
 gs {{preset==0?0.055459048831000002:(preset==1?0.063997604032021899:(preset==2?0.057077625570776301:(preset==3?0.074411604628179501:(preset==4?0.064795419634129298:(preset==5?0.076949505245484703:(preset==6?0.067515609487508996:(preset==7?0.073292479999999993:(s0*log(2)))))))))}}
 addUserKnob {7 go l logSideOffset t "OCIO LogCameraTransform logSideOffset" +DISABLED}
 go {{preset==0?0.50086779795500003:(preset==1?0.55201265686066503:(preset==2?0.55479452054794498:(preset==3?0.38553700000000002:(preset==4?-0.29590839268258601:(preset==5?0.410557184750733:(preset==6?0:(preset==7?0.51304735999999995:(o1))))))))}}
 addUserKnob {7 ls l linSideSlope t "OCIO LogCameraTransform linSideSlope" +DISABLED}
 ls {{preset==0?1:(preset==1?1:(preset==2?1:(preset==3?5.5555560000000002:(preset==4?2231.8263090676901:(preset==5?5.2631578947368398:(preset==6?155.97532699999999:(preset==7?1:(1))))))))}}
 addUserKnob {7 lo l linSideOffset t "OCIO LogCameraTransform linSideOffset" +DISABLED}
 lo {{preset==0?0.0048798088598100003:(preset==1?0.0057048244042473802:(preset==2?0:(preset==3?0.052271999999999999:(preset==4?64:(preset==5?0.052631578947368397:(preset==6?2.5597532699999999:(preset==7?0.0074999999999999997:(-o0))))))))}}
 addUserKnob {7 lb l linSideBreak t "OCIO LogCameraTransform linSideBreak" +DISABLED}
 lb {{preset==0?0:(preset==1?0:(preset==2?0.0078125:(preset==3?0.010591:(preset==4?-0.018056996119911298:(preset==5?0.01125:(preset==6?-0.01:(preset==7?0.0026240899999999999:(y1))))))))}}
 addUserKnob {7 sl l linearSlope t "OCIO LogCameraTransform linearSlope" +DISABLED}
 sl {{preset==0?16.396235389436512:(preset==1?16.184376489665894:(preset==2?10.540237741654536:(preset==3?5.3676735864473013:(preset==4?8.8030332103317619:(preset==5?6.6219437117758204:(preset==6?15.192688598850596:(preset==7?10.444266835878933:(1/k))))))))}}
 addUserKnob {7 logbreak l "log break" t "log-side value at the break" +DISABLED}
 logbreak {{gs*log(ls*lb+lo)/log(2)+go}}
 addUserKnob {7 linoff l "linear offset" t "offset of the linear segment" +DISABLED}
 linoff {{logbreak-sl*lb}}
 addUserKnob {1 clfbake_shaper l "" +STARTLINE +INVISIBLE}
 clfbake_shaper 1
}
 CMSTestPattern {
  inputs 0
  cube_size {{parent.cube_size}}
  name CMSTestPattern1
 }
 Expression {
  expr0 r<=parent.logbreak?(r-parent.linoff)/parent.sl:(pow(2,(r-parent.go)/parent.gs)-parent.lo)/parent.ls
  expr1 g<=parent.logbreak?(g-parent.linoff)/parent.sl:(pow(2,(g-parent.go)/parent.gs)-parent.lo)/parent.ls
  expr2 b<=parent.logbreak?(b-parent.linoff)/parent.sl:(pow(2,(b-parent.go)/parent.gs)-parent.lo)/parent.ls
  name InverseShaper
 }
 Input {
  inputs 0
  name Input1
 }
 Switch {
  inputs 2
  which {{parent.pattern}}
  name Switch1
 }
 Output {
  name Output1
 }
end_group
Group {
 name CLFGenerate
 tile_color 0x4a3a7aff
 xpos 0
 ypos 200
 addUserKnob {20 CLFGenerate}
 addUserKnob {26 about l " " T "<font color=#ccc><b>CLFGenerate</b> | part of <a href=https://github.com/jedypod/open-display-transform>open-display-transform</a><br>Bakes everything between the upstream CLFShaper and this node into a CLF."}
 addUserKnob {2 file t "Output path. Use a .ctf extension to write CTF instead of CLF. Empty: next to the script, named after the baked node."}
 addUserKnob {4 interpolation t "Interpolation recorded in the LUT3D node." M {tetrahedral trilinear}}
 addUserKnob {6 log_input l "log input" t "Omit the shaper from the CLF so it takes the shaper log encoding as input, the way the released OpenDRT OCIO config consumes its cubes. Default off: the shaper is embedded and the CLF takes linear input." -STARTLINE}
 addUserKnob {22 generate l Generate t "Bake the chain to a 3D LUT via GenerateLUT, then write the CLF with the shaper and node parameters embedded." T "def __clfbake():\n    import os, datetime, tempfile\n    import xml.etree.ElementTree as ET\n    import nuke\n\n    MARK = 'clfbake_shaper'\n    SKIP_CLASSES = ('Tab_Knob', 'Text_Knob', 'PyScript_Knob', 'Script_Knob',\n                    'Obsolete_Knob', 'Pulldown_Knob', 'Help_Knob',\n                    'BeginTabGroup_Knob', 'EndTabGroup_Knob')\n    SKIP_NAMES = ('name', 'xpos', 'ypos', 'selected', 'tile_color', 'note_font',\n                  'note_font_size', 'note_font_color', 'hide_input', 'cached',\n                  'dope_sheet', 'bookmark', 'postage_stamp', 'postage_stamp_frame',\n                  'gl_color', 'icon', 'indicators', 'knobChanged', 'onCreate',\n                  'onDestroy', 'updateUI', 'autolabel', 'panel', 'lifetimeStart',\n                  'lifetimeEnd', 'useLifetime', 'lock_connections', 'help',\n                  'mapsize', 'window', 'rootNodeUpdated', 'process_mask',\n                  'disable', 'label', 'group_view_position', 'show_group_view',\n                  'disable_group_view', 'clf_file')\n\n\n    def knob_values(n):\n        out = \[]\n        for name in n.knobs():\n            if name in SKIP_NAMES:\n                continue\n            try:\n                k = n\[name]\n            except Exception:\n                continue\n            if k.Class() in SKIP_CLASSES:\n                continue\n            try:\n                out.append((name, k.toScript()))\n            except Exception:\n                pass\n        return out\n\n\n    def default_path(node, short, ext='.clf'):\n        root = nuke.root().name()\n        d = os.path.dirname(root) if root and root != 'Root' else tempfile.gettempdir()\n        return os.path.join(d, '%s__%s%s' % (node.name(), short, ext)).replace(os.sep, '/')\n\n\n    def read_cube(path):\n        n, rows = None, \[]\n        for line in open(path):\n            t = line.split()\n            if not t or t\[0].startswith('#'):\n                continue\n            if t\[0] == 'LUT_3D_SIZE':\n                n = int(t\[1])\n            elif len(t) == 3 and t\[0]\[0] in '-+.0123456789':\n                rows.append(' '.join(t))\n        if n is None or len(rows) != n ** 3:\n            raise RuntimeError('unexpected cube %s: size %s, %d rows' % (path, n, len(rows)))\n        # .cube is red-fastest, CLF Array is blue-fastest\n        return n, \[rows\[r + n * g + n * n * b] for r in range(n) for g in range(n) for b in range(n)]\n\n\n    def write_clf(path, cube, shaper, nodes, interpolation, log_input):\n        \"\"\"shaper: dict with preset, shortname, cube_size, gs go ls lo lb sl (and xlog w0 o x0 y0 k).\"\"\"\n        n, rows = read_cube(cube)\n        ctf = os.path.splitext(path)\[1].lower() == '.ctf'\n        tail = nodes\[-1]\n        root = ET.Element('ProcessList', \{'version': '2'\} if ctf else \{'compCLFversion': '3'\})\n        root.set('id', '%s__%s' % (tail.name(), shaper\['shortname']))\n        root.set('name', tail.name())\n        ET.SubElement(root, 'InputDescriptor').text = (\n            shaper\['preset'] if log_input else 'Linear (%s shaper)' % shaper\['preset'])\n        ET.SubElement(root, 'OutputDescriptor').text = tail.name()\n        nb = ET.SubElement(ET.SubElement(root, 'Info'), 'NukeBake', version='1')\n        sh = ET.SubElement(nb, 'Shaper')\n        for k in ('preset', 'shortname', 'cube_size', 'gs', 'go', 'ls', 'lo', 'lb', 'sl', 'w0', 'o', 'x0', 'y0', 'k'):\n            if k in shaper:\n                sh.set(k, str(shaper\[k]))\n        sh.set('embedded', 'false' if log_input else 'true')\n        ns = ET.SubElement(nb, 'Nodes')\n        for node in nodes:\n            e = ET.SubElement(ns, 'Node', \{'class': node.Class(), 'name': node.name()\})\n            for name, val in knob_values(node):\n                ET.SubElement(e, 'Knob', name=name).text = val\n        ET.SubElement(nb, 'Generator', nuke=nuke.NUKE_VERSION_STRING,\n                      date=datetime.datetime.now().isoformat(timespec='seconds'),\n                      script=nuke.root().name())\n        if not log_input:\n            log = ET.SubElement(root, 'Log', inBitDepth='32f', outBitDepth='32f', style='cameraLinToLog')\n            ET.SubElement(log, 'LogParams', base='2',\n                          linSideSlope=repr(float(shaper\['ls'])), linSideOffset=repr(float(shaper\['lo'])),\n                          logSideSlope=repr(float(shaper\['gs'])), logSideOffset=repr(float(shaper\['go'])),\n                          linSideBreak=repr(float(shaper\['lb'])), linearSlope=repr(float(shaper\['sl'])))\n        lut = ET.SubElement(root, 'LUT3D', inBitDepth='32f', outBitDepth='32f', interpolation=interpolation)\n        arr = ET.SubElement(lut, 'Array', dim='%d %d %d 3' % (n, n, n))\n        if hasattr(ET, 'indent'):\n            ET.indent(root, '    ')\n        arr.text = '\\n' + '\\n'.join('            ' + r for r in rows) + '\\n        '\n        ET.ElementTree(root).write(path, encoding='UTF-8', xml_declaration=True)\n        return n\n\n\n    def bake_cube(generate_lut):\n        tmp = os.path.join(tempfile.gettempdir(), 'clfbake_%d.cube' % os.getpid()).replace(os.sep, '/')\n        generate_lut\['file'].setValue(tmp)\n        generate_lut\['file_type'].setValue('.cube')\n        f = nuke.frame()\n        nuke.execute(generate_lut, f, f)\n        return tmp\n\n\n    def read_bake(path):\n        root = ET.parse(path).getroot()\n        for e in root.iter():\n            if e.tag.split('\}')\[-1] == 'NukeBake':\n                return e\n        raise RuntimeError('%s has no NukeBake metadata' % path)\n\n\n    def restore_apply(nb, targets):\n        \"\"\"Apply recorded values to targets (nodes). Returns (done, shaper element).\"\"\"\n        targets, done = list(targets), \[]\n        sh = nb.find('Shaper')\n        for t in targets:\n            if sh is not None and MARK in t.knobs():\n                t\['preset'].setValue(sh.get('preset'))\n                for k in ('w0', 'o', 'x0', 'y0', 'k'):\n                    if sh.get(k) is not None:\n                        t\[k].setValue(float(sh.get(k)))\n                t\['cube_size'].setValue(int(sh.get('cube_size', 48)))\n                done.append(t.name())\n                targets.remove(t)\n                break\n        for e in nb.find('Nodes') if nb.find('Nodes') is not None else \[]:\n            match = None\n            for t in targets:\n                if t.Class() == e.get('class'):\n                    match = t\n                    break\n            if match is None:\n                continue\n            targets.remove(match)\n            for k in e:\n                name = k.get('name')\n                if name in match.knobs():\n                    try:\n                        match\[name].fromScript(k.text or '')\n                    except Exception:\n                        pass\n            done.append('%s <- %s' % (match.name(), e.get('name')))\n        return done, sh\n\n    SHORT = \['tloge', 'tlog', 'acescct', 'logc3', 'logc4', 'slog3', 'log3g10', 'davinci_intermediate', 'xlog']\n    gen = nuke.thisNode()\n\n    nodes, n = \[], gen.input(0)\n    while n is not None and MARK not in n.knobs():\n        nodes.append(n)\n        n = n.input(0)\n    if n is None:\n        raise RuntimeError('No CLFShaper found upstream of %s' % gen.name())\n    if not nodes:\n        raise RuntimeError('Nothing between %s and %s to bake' % (n.name(), gen.name()))\n    shaper_node = n\n    shaper = dict((k, shaper_node\[k].value()) for k in ('gs', 'go', 'ls', 'lo', 'lb', 'sl', 'w0', 'o', 'x0', 'y0', 'k'))\n    shaper\['preset'] = shaper_node\['preset'].value()\n    shaper\['shortname'] = SHORT\[int(shaper_node\['preset'].getValue())]\n    shaper\['cube_size'] = int(shaper_node\['cube_size'].value())\n    log_input = bool(gen\['log_input'].value())\n\n    path = gen\['file'].evaluate()\n    if not path:\n        path = default_path(nodes\[-1], shaper\['shortname'])\n        gen\['file'].setValue(path)\n\n    shaper_node\['pattern'].setValue(True)\n    try:\n        tmp = bake_cube(gen.node('GenerateLUT1'))\n    finally:\n        shaper_node\['pattern'].setValue(False)\n    size = write_clf(path, tmp, shaper, nodes, gen\['interpolation'].value(), log_input)\n    os.remove(tmp)\n    gen\['status'].setValue('wrote %s (%d nodes, %d^3, %s)' % (\n        os.path.basename(path), len(nodes), size, 'log input' if log_input else shaper\['shortname']))\n__clfbake()\n" +STARTLINE}
 addUserKnob {22 restore l Restore t "Read the CLF and apply the recorded parameters to the selected nodes (or to the upstream chain if nothing is selected)." -STARTLINE T "def __clfbake():\n    import os, datetime, tempfile\n    import xml.etree.ElementTree as ET\n    import nuke\n\n    MARK = 'clfbake_shaper'\n    SKIP_CLASSES = ('Tab_Knob', 'Text_Knob', 'PyScript_Knob', 'Script_Knob',\n                    'Obsolete_Knob', 'Pulldown_Knob', 'Help_Knob',\n                    'BeginTabGroup_Knob', 'EndTabGroup_Knob')\n    SKIP_NAMES = ('name', 'xpos', 'ypos', 'selected', 'tile_color', 'note_font',\n                  'note_font_size', 'note_font_color', 'hide_input', 'cached',\n                  'dope_sheet', 'bookmark', 'postage_stamp', 'postage_stamp_frame',\n                  'gl_color', 'icon', 'indicators', 'knobChanged', 'onCreate',\n                  'onDestroy', 'updateUI', 'autolabel', 'panel', 'lifetimeStart',\n                  'lifetimeEnd', 'useLifetime', 'lock_connections', 'help',\n                  'mapsize', 'window', 'rootNodeUpdated', 'process_mask',\n                  'disable', 'label', 'group_view_position', 'show_group_view',\n                  'disable_group_view', 'clf_file')\n\n\n    def knob_values(n):\n        out = \[]\n        for name in n.knobs():\n            if name in SKIP_NAMES:\n                continue\n            try:\n                k = n\[name]\n            except Exception:\n                continue\n            if k.Class() in SKIP_CLASSES:\n                continue\n            try:\n                out.append((name, k.toScript()))\n            except Exception:\n                pass\n        return out\n\n\n    def default_path(node, short, ext='.clf'):\n        root = nuke.root().name()\n        d = os.path.dirname(root) if root and root != 'Root' else tempfile.gettempdir()\n        return os.path.join(d, '%s__%s%s' % (node.name(), short, ext)).replace(os.sep, '/')\n\n\n    def read_cube(path):\n        n, rows = None, \[]\n        for line in open(path):\n            t = line.split()\n            if not t or t\[0].startswith('#'):\n                continue\n            if t\[0] == 'LUT_3D_SIZE':\n                n = int(t\[1])\n            elif len(t) == 3 and t\[0]\[0] in '-+.0123456789':\n                rows.append(' '.join(t))\n        if n is None or len(rows) != n ** 3:\n            raise RuntimeError('unexpected cube %s: size %s, %d rows' % (path, n, len(rows)))\n        # .cube is red-fastest, CLF Array is blue-fastest\n        return n, \[rows\[r + n * g + n * n * b] for r in range(n) for g in range(n) for b in range(n)]\n\n\n    def write_clf(path, cube, shaper, nodes, interpolation, log_input):\n        \"\"\"shaper: dict with preset, shortname, cube_size, gs go ls lo lb sl (and xlog w0 o x0 y0 k).\"\"\"\n        n, rows = read_cube(cube)\n        ctf = os.path.splitext(path)\[1].lower() == '.ctf'\n        tail = nodes\[-1]\n        root = ET.Element('ProcessList', \{'version': '2'\} if ctf else \{'compCLFversion': '3'\})\n        root.set('id', '%s__%s' % (tail.name(), shaper\['shortname']))\n        root.set('name', tail.name())\n        ET.SubElement(root, 'InputDescriptor').text = (\n            shaper\['preset'] if log_input else 'Linear (%s shaper)' % shaper\['preset'])\n        ET.SubElement(root, 'OutputDescriptor').text = tail.name()\n        nb = ET.SubElement(ET.SubElement(root, 'Info'), 'NukeBake', version='1')\n        sh = ET.SubElement(nb, 'Shaper')\n        for k in ('preset', 'shortname', 'cube_size', 'gs', 'go', 'ls', 'lo', 'lb', 'sl', 'w0', 'o', 'x0', 'y0', 'k'):\n            if k in shaper:\n                sh.set(k, str(shaper\[k]))\n        sh.set('embedded', 'false' if log_input else 'true')\n        ns = ET.SubElement(nb, 'Nodes')\n        for node in nodes:\n            e = ET.SubElement(ns, 'Node', \{'class': node.Class(), 'name': node.name()\})\n            for name, val in knob_values(node):\n                ET.SubElement(e, 'Knob', name=name).text = val\n        ET.SubElement(nb, 'Generator', nuke=nuke.NUKE_VERSION_STRING,\n                      date=datetime.datetime.now().isoformat(timespec='seconds'),\n                      script=nuke.root().name())\n        if not log_input:\n            log = ET.SubElement(root, 'Log', inBitDepth='32f', outBitDepth='32f', style='cameraLinToLog')\n            ET.SubElement(log, 'LogParams', base='2',\n                          linSideSlope=repr(float(shaper\['ls'])), linSideOffset=repr(float(shaper\['lo'])),\n                          logSideSlope=repr(float(shaper\['gs'])), logSideOffset=repr(float(shaper\['go'])),\n                          linSideBreak=repr(float(shaper\['lb'])), linearSlope=repr(float(shaper\['sl'])))\n        lut = ET.SubElement(root, 'LUT3D', inBitDepth='32f', outBitDepth='32f', interpolation=interpolation)\n        arr = ET.SubElement(lut, 'Array', dim='%d %d %d 3' % (n, n, n))\n        if hasattr(ET, 'indent'):\n            ET.indent(root, '    ')\n        arr.text = '\\n' + '\\n'.join('            ' + r for r in rows) + '\\n        '\n        ET.ElementTree(root).write(path, encoding='UTF-8', xml_declaration=True)\n        return n\n\n\n    def bake_cube(generate_lut):\n        tmp = os.path.join(tempfile.gettempdir(), 'clfbake_%d.cube' % os.getpid()).replace(os.sep, '/')\n        generate_lut\['file'].setValue(tmp)\n        generate_lut\['file_type'].setValue('.cube')\n        f = nuke.frame()\n        nuke.execute(generate_lut, f, f)\n        return tmp\n\n\n    def read_bake(path):\n        root = ET.parse(path).getroot()\n        for e in root.iter():\n            if e.tag.split('\}')\[-1] == 'NukeBake':\n                return e\n        raise RuntimeError('%s has no NukeBake metadata' % path)\n\n\n    def restore_apply(nb, targets):\n        \"\"\"Apply recorded values to targets (nodes). Returns (done, shaper element).\"\"\"\n        targets, done = list(targets), \[]\n        sh = nb.find('Shaper')\n        for t in targets:\n            if sh is not None and MARK in t.knobs():\n                t\['preset'].setValue(sh.get('preset'))\n                for k in ('w0', 'o', 'x0', 'y0', 'k'):\n                    if sh.get(k) is not None:\n                        t\[k].setValue(float(sh.get(k)))\n                t\['cube_size'].setValue(int(sh.get('cube_size', 48)))\n                done.append(t.name())\n                targets.remove(t)\n                break\n        for e in nb.find('Nodes') if nb.find('Nodes') is not None else \[]:\n            match = None\n            for t in targets:\n                if t.Class() == e.get('class'):\n                    match = t\n                    break\n            if match is None:\n                continue\n            targets.remove(match)\n            for k in e:\n                name = k.get('name')\n                if name in match.knobs():\n                    try:\n                        match\[name].fromScript(k.text or '')\n                    except Exception:\n                        pass\n            done.append('%s <- %s' % (match.name(), e.get('name')))\n        return done, sh\n\n    gen = nuke.thisNode()\n    nb = read_bake(gen\['file'].evaluate())\n    targets = \[n for n in nuke.thisParent().nodes() if n.isSelected()]\n    if not targets:\n        n = gen.input(0)\n        while n is not None:\n            targets.append(n)\n            if MARK in n.knobs():\n                break\n            n = n.input(0)\n    done, sh = restore_apply(nb, targets)\n    if sh is not None:\n        gen\['log_input'].setValue(sh.get('embedded') == 'false')\n    gen\['status'].setValue('restored: %s' % (', '.join(done) or 'nothing matched (select the nodes to restore)'))\n__clfbake()\n"}
 addUserKnob {26 status l " "}
}
 Input {
  inputs 0
  name Input1
 }
set Nc13ad00 [stack 0]
 GenerateLUT {
  file_type .cube
  name GenerateLUT1
 }
push $Nc13ad00
 Output {
  name Output1
 }
end_group
